{
  "name": "redsos-mesh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "worker:dev": "wrangler dev worker.ts --local",
    "worker:deploy": "wrangler deploy",
    "worker:kv:init": "wrangler kv:namespace create REDSOS_KV",
    "worker:tail": "wrangler tail",
    "deploy:all": "vite build && wrangler deploy",
    "cap:init": "cap init 'RedSOS IAGAMI' 've.gob.iagami.redsos'",
    "cap:add": "cap add android",
    "cap:build": "vite build && cap sync android",
    "cap:run": "cap run android",
    "cap:apk": "cd android && ./gradlew assembleRelease",
    "cap:apk:debug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.2.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase": "^12.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.105.0"
  }
}
